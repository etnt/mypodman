FROM python:3-alpine

RUN addgroup -g 10001 credential-proxy \
    && adduser -D -H -u 10001 -G credential-proxy -h /nonexistent -s /sbin/nologin credential-proxy

COPY credential_proxy.py /opt/credential_proxy.py
RUN chmod 0555 /opt/credential_proxy.py

USER 10001:10001
# The wizard supplies the socket path, token file, and key files as arguments.
ENTRYPOINT ["python3", "/opt/credential_proxy.py"]
