# The wizard maps the host user to UID/GID 1000. Keep these IDs fixed.
FROM debian:testing-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_NAME=dev
ARG NODE_VERSION=24.21.0
ARG HELIX_VERSION=25.07.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        bash-completion \
        build-essential \
        ca-certificates \
        curl \
        erlang-base \
        erlang-crypto \
        erlang-dev \
        erlang-eunit \
        erlang-inets \
        erlang-public-key \
        erlang-ssl \
        erlang-tools \
        gdb \
        git \
        jujutsu \
        less \
        openssh-client \
        pkg-config \
        procps \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        sudo \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install the pinned Node.js release with its bundled npm and checksum validation.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
        amd64) node_arch=x64 ;; \
        arm64) node_arch=arm64 ;; \
        *) echo "Node.js release does not support this architecture" >&2; exit 1 ;; \
    esac; \
    node_archive="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    curl --fail --location --retry 3 \
        "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
        --output /tmp/node-shasums.txt; \
    curl --fail --location --retry 3 \
        "https://nodejs.org/dist/v${NODE_VERSION}/${node_archive}" \
        --output "/tmp/${node_archive}"; \
    (cd /tmp && grep "  ${node_archive}$" node-shasums.txt | sha256sum --check -); \
    mkdir -p /opt/node; \
    tar -xJf "/tmp/${node_archive}" --strip-components=1 -C /opt/node; \
    ln -s /opt/node/bin/node /usr/local/bin/node; \
    ln -s /opt/node/bin/npm /usr/local/bin/npm; \
    ln -s /opt/node/bin/npx /usr/local/bin/npx; \
    rm "/tmp/${node_archive}" /tmp/node-shasums.txt

# Debian Testing does not package Helix on every architecture. Install the pinned official release.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
        amd64) helix_arch=x86_64 ;; \
        arm64) helix_arch=aarch64 ;; \
        *) echo "Helix release does not support this architecture" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --retry 3 \
        "https://github.com/helix-editor/helix/releases/download/${HELIX_VERSION}/helix-${HELIX_VERSION}-${helix_arch}-linux.tar.xz" \
        --output /tmp/helix.tar.xz; \
    tar -xJf /tmp/helix.tar.xz -C /opt; \
    mv "/opt/helix-${HELIX_VERSION}-${helix_arch}-linux" /opt/helix; \
    ln -s /opt/helix/hx /usr/local/bin/hx; \
    ln -s /opt/helix/hx /usr/local/bin/helix; \
    find /opt/helix/runtime/grammars -type f \
        ! -name 'bash.so' ! -name 'c.so' ! -name 'cpp.so' \
        ! -name 'cmake.so' ! -name 'dockerfile.so' ! -name 'diff.so' \
        ! -name 'edoc.so' ! -name 'erlang.so' ! -name 'git-config.so' \
        ! -name 'git-rebase.so' ! -name 'gitattributes.so' ! -name 'gitcommit.so' \
        ! -name 'gitignore.so' ! -name 'html.so' ! -name 'javascript.so' \
        ! -name 'json.so' ! -name 'jsx.so' ! -name 'make.so' \
        ! -name 'markdown.so' ! -name 'markdown_inline.so' ! -name 'python.so' \
        ! -name 'sshclientconfig.so' ! -name 'toml.so' ! -name 'tsx.so' \
        ! -name 'typescript.so' ! -name 'xml.so' ! -name 'yaml.so' -delete; \
    rm /tmp/helix.tar.xz

ENV HELIX_RUNTIME=/opt/helix/runtime

RUN set -eux; \
    case "$USER_NAME" in \
        ''|*[!a-zA-Z0-9_-]*) echo "USER_NAME must contain only letters, digits, _ or -" >&2; exit 1 ;; \
    esac; \
    groupadd --gid 1000 "$USER_NAME"; \
    useradd --uid 1000 --gid 1000 --create-home --home-dir "/home/$USER_NAME" --shell /bin/bash "$USER_NAME"; \
    usermod --append --groups sudo "$USER_NAME"; \
    printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$USER_NAME" > "/etc/sudoers.d/$USER_NAME"; \
    chmod 0440 "/etc/sudoers.d/$USER_NAME"; \
    visudo --check --file="/etc/sudoers.d/$USER_NAME"

LABEL io.mypodman.sandbox-user="${USER_NAME}"
ENV HOME="/home/${USER_NAME}"
USER 1000:1000
WORKDIR /home/${USER_NAME}
CMD ["/bin/bash"]
